# ---------------------------------------------------------------------------
# Adaptive AI Interviewer — environment template
# Copy to `.env` before `docker compose up`.  The API refuses to boot if any
# variable without a default is missing (see backend/app/config.py).
# ---------------------------------------------------------------------------

APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# Host port the API is published on. Change it if 8000 is already taken on your
# machine (Postgres and Redis are already offset to 5433 / 6380 for the same reason).
API_HOST_PORT=8000

# --- Postgres (used by docker-compose to create the DB) ---------------------
POSTGRES_USER=interviewer
POSTGRES_PASSWORD=interviewer
POSTGRES_DB=interviewer

# --- Required by the API ----------------------------------------------------
# Host names `postgres` / `redis` resolve inside the compose network.
# Running the API outside Docker? Use localhost:5433 / localhost:6380.
DATABASE_URL=postgresql+asyncpg://interviewer:interviewer@postgres:5432/interviewer
REDIS_URL=redis://redis:6379/0

# Signs every JWT. Min 32 chars. Changing it invalidates all issued tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef

# --- Authentication (all optional; these are the defaults) ------------------
# Access tokens cannot be revoked, so they are short.
# ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are long-lived but single-use: every refresh rotates them.
# REFRESH_TOKEN_TTL_DAYS=30
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15

# --- LLM chokepoint (Day 3) -------------------------------------------------
# Selected provider and model for this build. NVIDIA serves Nemotron behind an
# OpenAI-compatible endpoint, which is why the OpenAI Python SDK is the client.
#
# REQUIRED. Get one from https://build.nvidia.com/ and paste it into your local
# .env only. It is never committed: `.env` is gitignored, the value is held as a
# pydantic SecretStr, and no log line or error message prints it.
# The API refuses to boot if LLM_PROVIDER_ORDER contains `nvidia` and this is
# empty - a missing key is a boot failure, not a 401 mid-interview.
NVIDIA_API_KEY=

# --- Offline stub provider (Day 5) ------------------------------------------
# `stub` answers from recordings in backend/fixtures/llm/ instead of the network.
# It needs NO API key, makes NO network call, and is deterministic - which is what
# makes the test suite independent of any vendor's uptime.
#
#   LLM_PROVIDER_ORDER=stub          # fully offline; no NVIDIA_API_KEY required
#   LLM_PROVIDER_ORDER=nvidia,stub   # real answers, recordings as the fallback
#
# LLM_STUB_FIXTURE_DIR=              # blank = backend/fixtures/llm
# LLM_STUB_ON_MISSING=strict         # strict | synthesize
#   strict     - raise when no recording matches. The default, so a suite that
#                meant to replay can never silently run on invented data.
#   synthesize - derive a shape-correct (but meaningless) object from the schema,
#                for developing a phase before any recording of it exists.
# Either way, CallMeta.structured_mode says which happened: stub_replay or
# stub_synthesized. See backend/fixtures/llm/README.md.

# Optional; these are the defaults.
# LLM_PROVIDER_ORDER=nvidia            # comma-separated, highest priority first
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_TIMEOUT_S=60                     # wall clock ceiling for one provider call
# LLM_MAX_ATTEMPTS_PER_PROVIDER=2      # tries before failing over
# LLM_SCHEMA_MAX_RETRIES=2             # re-prompts when output fails validation
# LLM_CACHE_ENABLED=true               # deterministic tasks only
# LLM_CACHE_TTL_S=604800
# LLM_BREAKER_FAILURE_THRESHOLD=3      # failures that take a provider out of rotation
# LLM_BREAKER_COOLDOWN_S=30
# LLM_REASONING_ENABLED=true           # global switch; a task must also ask for it
# LLM_REASONING_BUDGET_TOKENS=4096

# --- Observability (Day 4) --------------------------------------------------
# Structured logging is always on. Tracing spans are always created (that is
# what puts a trace_id on every log line); OTEL_EXPORTER decides whether they
# are shipped anywhere. `none` needs no infrastructure and is the default.
#
# LOG_FORMAT=json                      # `text` for a readable terminal; both redact
# OTEL_ENABLED=true                    # false makes every span a no-op
# OTEL_SERVICE_NAME=adaptive-ai-interviewer
# OTEL_EXPORTER=none                   # none | console | otlp | langfuse
#
# OTEL_EXPORTER=otlp needs the full traces URL of a collector:
# OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_HEADERS=x-api-key=...  # optional, `key=value,key=value`
#
# OTEL_EXPORTER=langfuse needs a running Langfuse (see docs/observability.md):
#   docker compose -f infra/langfuse/docker-compose.langfuse.yml up -d
# From inside the api container, `localhost` is the container — use
# http://host.docker.internal:3000 there, http://localhost:3000 on the host.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
