# Copy to .env.local for local overrides. Nothing here is a secret, and nothing
# here may ever be one: every VITE_* variable is compiled into the public bundle.

# Where the browser sends API requests. Leave empty to use the same origin
# (the Vite dev/preview proxy below). The backend sets its refresh cookie with
# SameSite=Strict and has no CORS middleware, so a different origin will not work.
VITE_API_BASE_URL=

# Dev/preview server only (no VITE_ prefix: never exposed to the browser).
# Where the Vite proxy forwards /api requests: the locally running FastAPI app.
API_PROXY_TARGET=http://localhost:8000
